<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- xov-build / xov-install / xov-symbolicate / xov-bin 四个 helper 的签名权彄。
     移植自 xosvi 的 Support/bin-entitlements.plist（键集不动，只改注释）。

     为什么需要这么全：iOS 的沙箱在**每次 exec 时**按新二进制的签名重算权限，
     cp / insert_dylib / ldid / install_name_tool 跑起来用的是自己的 entitlements，
     不是 xovd 的。要写别的 App Bundle，必须同时有绝对路径读写 + container-manager
     + vfs.open-by-id，少一条就 EPERM。

     xov-bin 的 `sign` 子命令用 `ldid -S`「不带参数」重签 App 包内工具 —— 那样取的是
     **本进程自身签名里的**这份 entitlements，所以四个 helper 全部用本文件签名，
     别只给 xov-bin 用。 -->
<plist version="1.0">
<dict>
	<key>platform-application</key>
	<true/>
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>com.apple.private.security.container-manager</key>
	<true/>
	<key>com.apple.private.security.disk-device-access</key>
	<true/>
	<key>com.apple.private.security.storage.AppBundles</key>
	<true/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>
	<key>com.apple.private.MobileContainerManager.allowed</key>
	<true/>
	<key>com.apple.private.MobileContainerManager.lookup</key>
	<true/>
	<key>com.apple.private.MobileContainerManager.otherIdLookup</key>
	<true/>
	<key>com.apple.private.vfs.open-by-id</key>
	<true/>
	<key>com.apple.private.vfs.allow-low-space-writes</key>
	<true/>
	<key>com.apple.private.persona-mgmt</key>
	<true/>
	<key>com.apple.security.exception.files.absolute-path.read-write</key>
	<array>
		<string>/</string>
	</array>
	<key>task_for_pid-allow</key>
	<true/>
	<key>jb.pmap_cs.custom_trust</key>
	<string>PMAP_CS_APP_STORE</string>
</dict>
</plist>
