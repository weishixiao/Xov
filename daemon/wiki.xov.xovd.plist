<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- xovd 的 launchd 描述，装到 $APELIN_PREFIX/Library/LaunchDaemons/wiki.xov.xovd.plist
     （本机 roothide：<bootstrap>/Library/LaunchDaemons/）。

     这里写的是**逻辑路径**（/usr/libexec/xovd、/var/log/xovd.log），不是 jbroot 里的
     真实路径，也不用 @PREFIX@ 之类占位符 —— launchd 不认识占位符。roothide 上
     `icli svc bootstrap` / `icli svc load` 会像 launchctl 那样先把 launchd 要读的路径
     就地改写成 jbroot 下的真实路径再加载（`icli svc paths` 只预览、不落盘），所以
     这里绝不能写死 .jbroot-XXXX 前缀（设备重启/重新越狱后那个名字会变）。
     rootless 包的 /var/jb 前缀由 build.sh 在打包时加到 ProgramArguments 上，
     仓库里这份文件保持逻辑路径。 -->

<!-- 常驻形态：RunAtLoad + KeepAlive，开机即起、退了立刻补。
     xovd 默认连续 900s 无请求自退（见 xovd.c 的 kIdleSecs）；那样和 KeepAlive 打架，
     所以这里用 XOVD_IDLE_SECS=0 显式关掉自退（xovd 认 0 = 常驻）。
     代价是一个 root 进程常驻内存；要回到「按需拉起」就把 KeepAlive/RunAtLoad 去掉、
     删掉 EnvironmentVariables，守护会恢复 900s 自退。 -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>wiki.xov.xovd</string>

	<key>ProgramArguments</key>
	<array>
		<string>/usr/libexec/xovd</string>
	</array>

	<key>MachServices</key>
	<dict>
		<key>wiki.xov.service</key>
		<true/>
	</dict>

	<key>RunAtLoad</key>
	<true/>

	<key>KeepAlive</key>
	<true/>

	<key>ThrottleInterval</key>
	<integer>1</integer>

	<key>EnvironmentVariables</key>
	<dict>
		<key>XOVD_IDLE_SECS</key>
		<string>0</string>
	</dict>

	<key>StandardOutPath</key>
	<string>/var/log/xovd.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/xovd.log</string>

	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
